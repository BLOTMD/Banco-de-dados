create table tb_cliente(
	id_cliente serial primary key,
	tx_nome varchar(255),
	vl_idade numeric(3, 0),
	tx_uf varchar(2),
	
	constraint  ck_checagem_idade check (vl_idade > 0),
	constraint  ck_checagem_estado check (tx_uf = upper(tx_uf))
)


