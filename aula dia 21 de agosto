--10
select count(id_matricula) 
from tb_professor  p
	inner join tb_disciplina d
	on id_professor = id_disciplina 
	left join tb_nota n
	on d.id_disciplina = n.id_disciplina
	left join tb_matricula m
	on n.id_matricula = m.id_matricula 
	left join tb_aluno a
	on m.id_aluno = a.id_aluno
	group by p.id_professor,p.tx_nome 

