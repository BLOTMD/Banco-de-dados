explain
select cd_usuario,dt_pedido,vl_total from tb_pedidos
where cd_usuario = 1234;			


create index
	idx_usuario_cd	
	on tb_pedidos(cd_usuario);


select u.tx_nome,p.id_pedido,pr.tx_nome,i.nr_quantidade,i.vl_unitario
from tb_usuarios u
inner join tb_pedidos p
	on u.id_usuario = p.cd_usuario 
	inner join tb_itens_pedido i
	 	on i.cd_pedido = p.id_pedido 
	 	inner join tb_produtos pr
	 		on i.cd_produto = pr.id_produto 
	 		where u.id_usuario = 1234;

CREATE INDEX idx_pedidos_cd_usuario
ON tb_pedidos (cd_usuario);

CREATE INDEX idx_pedidos_produto
ON tb_itens_pedido (cd_produto);


