select id_pedido,vl_total
from tb_pedidos 
where upper(tx_status) = Upper('ENTREGUE') or dt_pedido > '2023-05-23'

create index idx_pedido_data
on tb_pedidos(upper(tx_status),dt_pedido);

select u.tx_nome,e.tx_logradouro,e.nr_numero,e.tx_cidade
from tb_usuarios u 
inner join tb_enderecos e  
	on u.id_usuario = e.cd_usuario
	
CREATE INDEX idx_enderecos_cd_usuario
ON tb_enderecos(cd_usuario);
	
